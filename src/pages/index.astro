---
import '../styles/global.css';
import fs from 'node:fs';
import de from '../i18n/de_de.json';
import logoSource from '../assets/rindr.svg?raw';

// preloader: the logo's paths (the file stays as exported) – outline + clip shape for the fill
const logoPaths = [...logoSource.matchAll(/<path[^>]*\sd="([^"]+)"/g)].map(m => m[1]);
const logoViewBox = logoSource.match(/viewBox="([^"]+)"/)?.[1] || '0 0 1417.323 1417.323';

// German default texts rendered at build time (no flash); app.js calls applyDom() for other languages
const tr = (k) => k.split('.').reduce((n, p) => n?.[p], de) ?? k;

// HDRIs offered in the environment panel: all .hdr/.exr files from public/hdr
const hdris = fs.existsSync('public/hdr')
    ? fs.readdirSync('public/hdr').filter(f => /\.(hdr|exr)$/i.test(f)).sort()
    : [];

// Social preview (Open Graph / Twitter): absolute URLs only when `site` is set (SITE_URL at build time)
const base = import.meta.env.BASE_URL;
const abs = (path) => Astro.site ? new URL(base + path, Astro.site).href : base + path;
const pageUrl = abs('');
const ogImage = abs('og-image.png');

// Content-Security-Policy as <meta> (works on GitHub Pages too; header-only parts – frame-ancestors,
// X-Frame-Options, Permissions-Policy … – come from public/.htaccess resp. public/coi-serviceworker.js).
// Only in the production build: the dev server needs its HMR websocket and inline scripts.
// wasm-unsafe-eval: WebAssembly (Draco, Basis, web-ifc, denoiser); worker blob: Draco/KTX2 workers;
// style unsafe-inline: <style> in page + logo SVG; connect https: the AI service (KI.endpoint in config.js) and textures
// a model references on another server – loaded only on request (remote-textures.js, asset window; per-file progress
// needs fetch, so not only images – decided by the user, Oct. 2026).
const CSP = [
    "default-src 'self'",
    "script-src 'self' 'wasm-unsafe-eval'",
    "worker-src 'self' blob:",
    "style-src 'self' 'unsafe-inline'",
    "img-src 'self' data: blob:",
    "font-src 'self' data:",
    "media-src 'self' data: blob:",
    "connect-src 'self' data: blob: https:",
    "manifest-src 'self'",
    "object-src 'none'",
    "base-uri 'self'",
    "form-action 'none'",
].join('; ');

---

<!doctype html>
<html lang="de">
    <head>
        <meta charset="UTF-8" />
        {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={CSP} />}
        <meta name="referrer" content="strict-origin-when-cross-origin" />
        <!-- Cross-origin isolation where the server cannot send COOP/COEP (GitHub Pages): coi-serviceworker sets
             the headers itself (one reload on the first visit). Already isolated (own server via .htaccess, dev
             server) → it does nothing. Messages only with ?debug. -->
        <script is:inline src={`${base}coi-config.js`}></script>
        <script is:inline src={`${base}coi-serviceworker.js`}></script>
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title data-i18n="page.title">{tr('page.title')}</title>
        <meta name="description" content={tr('page.description')} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="RINDR" />
        <meta property="og:title" content={tr('page.title')} />
        <meta property="og:description" content={tr('page.description')} />
        <meta property="og:url" content={pageUrl} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={tr('page.ogImageAlt')} />
        <meta property="og:locale" content="de_DE" />
        <meta property="og:locale:alternate" content="en_US" />
        <meta name="twitter:card" content="summary_large_image" />
        <link rel="icon" type="image/png" href={`${base}favicon-96x96.png`} sizes="96x96" />
        <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
        <link rel="shortcut icon" href={`${base}favicon.ico`} />
        <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
        <meta name="apple-mobile-web-app-title" content="RINDR" />
        <link rel="manifest" href={`${base}site.webmanifest`} />
        <style is:global>
            /* preloader (see #preloader): the blue logo is revealed by a conic sweep from the top,
               clockwise (scripts loading, no progress known – easing towards ~3/4, viewer.js completes it) */
            #preloader { background: #171717; }   /* the app's own background (bg-neutral-900) – no jump in brightness */
            @property --preloader-sweep { syntax: '<percentage>'; inherits: false; initial-value: 0%; }
            #preloader [data-fill] {
                -webkit-mask-image: conic-gradient(#000 var(--preloader-sweep), transparent 0);
                mask-image: conic-gradient(#000 var(--preloader-sweep), transparent 0);
                animation: preloader-sweep 7s cubic-bezier(0.12, 0.7, 0.3, 1) forwards;
            }
            @keyframes preloader-sweep { to { --preloader-sweep: 74%; } }
            @media (prefers-reduced-motion: reduce) { #preloader [data-fill] { animation-duration: 0.01s; } }
        </style>
    </head>
    <!-- no text selection in the interface (user: texts and selection frames came up while dragging in panels); fields
         stay editable, texts worth copying opt back in with select-text (notices, dialogs, About, BCF comments) -->
    <body data-rindr-app class="m-0 overflow-hidden bg-neutral-900 font-sans select-none">
        <!-- the app = one <rindr-player> with every feature, created by app.js (its markup: scripts/player/template.js,
             its styles: styles/player.css – docs/player.md) -->
        <!-- preloader until the app has started (viewer.js hidePreloader): the logo in dark grey with a soft shadow on the
             app's own background (no jump in brightness when it goes), turned accent blue by a sweep around its centre
             (like a clock hand). CSS only (no
             inline script – CSP): the sweep runs towards ~3/4 while the scripts load; viewer.js completes it and fades
             the screen out -->
        <div id="preloader" class="pointer-events-none fixed inset-0 z-[70] flex flex-col items-center justify-center gap-5 transition-opacity duration-500" aria-hidden="true">
            <div class="relative size-36 [filter:drop-shadow(0_6px_14px_rgb(0_0_0/0.55))]">
                <svg viewBox={logoViewBox} class="absolute inset-0 size-full"><g class="fill-[#3a3a3a]">{logoPaths.map(d => <path d={d} />)}</g></svg>
                <svg data-fill viewBox={logoViewBox} class="absolute inset-0 size-full"><g class="fill-sky-500">{logoPaths.map(d => <path d={d} />)}</g></svg>
            </div>
            <div data-i18n="page.loading" class="text-sm tracking-wide text-white/55">{tr('page.loading')}</div>
        </div>

        <script is:inline id="hdr-list" type="application/json" set:html={JSON.stringify(hdris).replaceAll("<", "\\u003c")}></script>
        <script>
            import "../scripts/app.js";
        </script>
    </body>
</html>
